state rotationSpeed = 0.5deg
state activeScale = 1.0

scene ProductShowcase {
    camera main {
        position: (0, 1.5, 5.5)
        fov: 45
    }

    environment {
        background: "#080812"
        lighting: "studio"
    }

    light sun {
        type: directional
        color: "#ffffff"
        intensity: 2.5
        position: (5, 10, 5)
    }

    light ambient {
        type: ambient
        color: "#404060"
        intensity: 0.6
    }

    model phone {
        source: "./assets/model.glb"
        position: (0, 0, 0)
        scale: 1.0

        animate {
            rotation.y += rotationSpeed
        }

        interaction {
            hover {
                scale = 1.15
            }
            click {
                rotation.y += 45deg
            }
        }
    }

    scroll animation {
        0% {
            camera.position.z = 6
        }
        100% {
            camera.position.z = 3.5
        }
    }
}

page Home {
    section hero {
        heading "NOVA 3D Experience"
        text "Build high-performance 3D websites with minimal code."
        button "Explore Interactive Model" {
            click => navigate("/explore")
        }
    }

    scene ProductShowcase

    card featureCard {
        heading "Declarative 3D Scene Graph"
        text "Create cameras, lights, materials, and GLTF models effortlessly in native NOVA syntax."
    }
}
