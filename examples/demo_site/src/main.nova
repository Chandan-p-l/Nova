state rotationSpeed = 0.5deg
state activeScale = 1.0
state activeColor = "#6366f1"

scene CyberShowcase {
    camera main {
        position: (0, 1.5, 5.5)
        fov: 45
    }

    environment {
        background: "#06060c"
        lighting: "studio"
    }

    light sun {
        type: directional
        color: "#ffffff"
        intensity: 2.5
        position: (5, 10, 5)
    }

    light ambient {
        type: ambient
        color: "#404060"
        intensity: 0.6
    }

    model cyberCore {
        source: "./assets/cybercore.glb"
        position: (0, 0, 0)
        scale: 1.0

        animate {
            rotation.y += rotationSpeed
        }

        interaction {
            hover {
                scale = 1.15
            }
            click {
                rotation.y += 45deg
            }
        }
    }

    scroll animation {
        0% {
            camera.position.z = 6
        }
        100% {
            camera.position.z = 3.5
        }
    }
}

page Home {
    nav navbar {
        heading "NOVA CYBERCRAFT"
        link "Experience"
        link "Architecture"
        link "GitHub"
    }

    section hero {
        heading "CyberCraft 3D Hardware"
        text "Experience next-generation product design in native three dimensions. Powered by NOVA, the domain-specific compiled 3D language for the web."
        button "Explore Source Code" {
            click => open "https://github.com/Chandan-p-l/Nova.git"
        }
    }

    scene CyberShowcase

    container grid {
        card feature1 {
            heading "Declarative 3D Graphs"
            text "Zero low-level boilerplate. Declare cameras, lighting, materials, and GLTF models in native NOVA syntax."
        }

        card feature2 {
            heading "Signal-Driven Reactivity"
            text "Declarative state mutations automatically synchronize 3D model transforms, materials, and DOM UI elements in real-time."
        }

        card feature3 {
            heading "Rust Compiler Engine"
            text "Built from scratch in Rust with sub-millisecond compilation speed, strict type checking, and WebGL/WebGPU render targets."
        }
    }
}
